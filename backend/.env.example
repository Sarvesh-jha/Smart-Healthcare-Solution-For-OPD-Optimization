# ==========================================
# MEDIrxCARE Backend Production Environment
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (Required)
MONGODB_URI=mongodb://127.0.0.1:27017/medirxcare

# Authentication & Security (Required in Production)
JWT_SECRET=replace-with-a-secure-random-64-char-string
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:4173,http://localhost:5173,http://localhost:8080
CLIENT_ORIGIN=http://localhost:4173

# AI & Clinical Triage Engine (Optional - Falls back to Clinical Rules Engine if omitted)
# GEMINI_API_KEY=your-google-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
